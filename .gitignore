# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Datos pesados — referencia, no versionar
sprints/*/objetivo_2_entrenamiento/logs/*.pt
sprints/*/objetivo_2_entrenamiento/logs/*.pth
sprints/*/objetivo_2_entrenamiento/logs/*.h5
sprints/*/objetivo_2_entrenamiento/logs/checkpoints/

# Pero SÍ versionar curvas y métricas de texto
!sprints/*/objetivo_2_entrenamiento/logs/*.csv
!sprints/*/objetivo_2_entrenamiento/logs/*.log
!sprints/*/objetivo_2_entrenamiento/logs/*.json

# Salidas SLURM en logs/ del repo (raw .out/.err pueden ser pesados).
# Copiar a sprints/<sprint>/<objetivo>/logs/ solo lo que valga versionar.
logs/*
!logs/.gitkeep

# Excepción — logs SLURM del experimento completo DSMIL (Objetivo 3,
# Sprint B4, job 4137). Son la única traza post-mortem porque sacct
# está deshabilitado (CLAUDE.md workaround C).
!logs/eg_dsmil_full_4137.out
!logs/eg_dsmil_full_4137.err

# Resultados de entrenamiento (containment: viven bajo results/), pero los
# artefactos pesados NO se versionan. Sí se versiona texto/métricas.
results/**/*.pt
results/**/*.pth
results/**/*.h5
results/**/*.pkl
results/**/checkpoints/
results/**/events.out.tfevents.*
!results/.gitkeep

# Pero SÍ versionar los *_results.pkl (predicciones por slide, pocos KB —
# verdad de referencia que citan los resultados.md de cada sprint).
!results/**/*_results.pkl

# PDFs transitorios del deck de presentación de cada sprint.
# Son referencia visual local (paleta/branding) para diseñar assets, no
# fuente de verdad — el contenido vive en sprints/<sprint>/<obj>/figuras/
# y en `presentacion_contenido_completo.md`. Si en algún sprint se quiere
# un snapshot histórico, commit explícito con `git add -f`.
sprints/**/CLAM_Sprint_*.pdf

# Decks .pptx de cada sprint: derivados locales (branding OnlyOffice), NO fuente
# de verdad. La fuente vive en el generate_*_deck.py + convenciones_deck_*.md + el
# guion. Precedente: 0 pptx trackeados en el repo. Snapshot histórico → `git add -f`.
sprints/**/*.pptx

# Guion extraído del deck por scripts/extraer_guion_deck.py. Derivado del .pptx, que
# a su vez es derivado: la fuente canónica del guion son las llamadas notes(...) del
# generador. Se regenera en un comando y si se versionara derivaría en silencio.
sprints/**/CLAM_Sprint*_guion.md

# Binarios de templates que Ernesto/Sebastián suben a un sprint (PDFs pesados de
# los .pptx de Sebastián). NO versionar: son plantillas locales, no fuente.
sprints/B7_sprint7/*.pdf

# Salidas PESADAS de interpretabilidad mammoth (30 heatmaps por experto + top-k
# hi-res del .svs, cientos de MB). Se versiona solo lo curado y liviano (montage +
# expert_usage.csv + slot_usage.csv + meta.json). Regenerar con mammoth_interpretability.py.
sprints/**/interpretabilidad*/**/heatmaps/
sprints/**/interpretabilidad*/**/topk_patches/
sprints/**/interpretabilidad*/**/topk_contact_sheet.png

# Mismo criterio para la interpretabilidad del B7, que vive bajo results/ (la salida
# del job 4589). Medido 18-jul: heatmaps/ 301 MB y las vistas individuales de atención
# a resolución completa ~10 MB cada una. Se versiona lo liviano y citable:
# attention_side_by_side.png (el entregable, ~1 MB), attention_stats.json,
# attention_summary.json, expert_usage.csv, slot_usage.csv, meta.json.
# Regenerar con clam_vs_mammoth_attention.py + run_b7_expert_interp.sh.
results/**/interpretabilidad/**/heatmaps/
results/**/interpretabilidad/**/topk_patches/
results/**/interpretabilidad/**/topk_contact_sheet.png
results/**/interpretabilidad/**/attention_clam.png
results/**/interpretabilidad/**/attention_mammoth.png

# Zips de entregables (derivados curados para adjuntar a un correo, ej.
# interpretabilidad_liviano.zip). Como los .pptx/.pdf: derivados locales, NO fuente.
# La fuente versionada es la carpeta interpretabilidad/. Regenerables.
sprints/**/*.zip

# Slides locales que Ernesto sube para que Claude las revise/actualice (PDFs,
# pptx, etc.). Carpeta de trabajo local — NO versionar. El contenido de verdad
# vive en sprints/<sprint>/<obj>/ (figuras, guion_montaje, presentacion_*.md).
papers/presentations/

# OBJ-A interpretabilidad MAMMOTH: parches y heatmaps INDIVIDUALES (1000+ PNGs
# full-res, ~1.6GB). Son REGENERABLES con scripts/mammoth_interpretability.py
# desde el checkpoint → se tratan como job output (no van a git). SÍ se versionan
# los entregables-resumen citables (montages, contact sheets, cross_slide, subset,
# expert_usage.csv, meta.json, resultados.md) que quedan fuera de esta regla.
sprints/**/interpretabilidad/*/heatmaps/
sprints/**/interpretabilidad/*/topk_patches/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code local state
.claude/projects/
.claude/todos/
.claude/cache/
# settings.json acumula permisos pre-aprobados durante el uso (allow-list de
# comandos one-shot, paths absolutos a $HOME/$TMP, etc.). Es local de cada
# usuario/máquina, no config del proyecto — cada sesión nueva reconstruye su
# allow-list naturalmente. Si en el futuro hace falta un baseline compartido,
# crear .claude/settings.json.example curado a mano.
.claude/settings.json

# Secretos
*.env
.env.local
conf.env

# Snapshot pesado del trabajo heredado de Eduardo (mammoth). El código
# irremplazable vive extraído en key_sources/ (committeado); el tarball es
# backup local de 23 MB (incluye assets/PDFs de MAMMOTH), no va a git.
sprints/B4_sprint4/objetivo_6_mammoth/eduardo_snapshot/*.tar.gz
.handoffs/

# Paquete de envio de heatmaps (derivado; el original versionado esta en results/)
sprints/B7_sprint7/envio_heatmaps/*.png
sprints/B7_sprint7/envio_heatmaps/*.zip

# Interpretabilidad B8 sobre la 129741: los 30 heatmaps por experto (85 MB) y los 240
# recortes top-k (34 MB) son REGENERABLES en ~11 min de CPU desde el checkpoint + el h5
# (scripts/mammoth_interpretability.py, determinista). Lo que se versiona es su resumen
# visual, que es lo que se presenta: heatmap_montage.png y topk_contact_sheet.png, mas
# todos los CSV/JSON.
results/b8_hovernext_129741/interp/expertos/heatmaps/
results/b8_hovernext_129741/interp/expertos/topk_patches/

# Barrido de registro multi-region: los JSON son la verdad de campo y pesan poco;
# los PNG (~108 x 400 KB) se regeneran desde el JSON con el mismo script.
sprints/B8_sprint8/anotaciones_patologo/regiones_escaneo/barrido_138/*.png
sprints/B8_sprint8/anotaciones_patologo/regiones_escaneo/barrido_rot/*.png

# Salida de HoVer-NeXt (job 5008 en adelante): son 11 GB por lamina y `results/**/*.zip`
# NO estaba cubierto por las reglas de arriba, que solo excluyen *.pt/*.pth/*.h5/*.pkl.
# Un `git add results/b8_hovernext_129741/` intentaba versionar un _inst.zip de 9,7 GB.
# La verdad de campo chica de esta corrida es `pred_mitosis.tsv` (8,5 KB), que SI se versiona
# al cerrar el objetivo; el resto son intermedios reproducibles relanzando el .slurm.
results/**/hovernext/**/*.zip
results/**/hovernext/**/class_inst.json
# Los pred_<clase>.tsv de las OTRAS clases son volcados por nucleo: 88 MB en el barrido de
# las 11 laminas (job 5070), con archivos de 5,7 MB. Mismo criterio que arriba: reproducibles
# relanzando el .slurm, y lo que se analiza es la mitosis. Se versiona solo ese.
results/**/hovernext/**/pred_*.tsv
!results/**/hovernext/**/pred_mitosis.tsv

# Descriptores por instancia del eje 3 del B9 (`b9_descriptores_nucleos.py`): 44 MB en las 12
# laminas y son un INTERMEDIO regenerable en ~10 min de CPU desde `pinst_pp.zip`, que ya esta
# en disco. Lo que se versiona es la verdad de campo chica: `marcas_grado.csv`, las 107 marcas
# resueltas. Declarado asi en `sprints/B9_sprint9/ejes_nucleares/prereg.md` §5.
results/b9_nucleos/*_nucleos.npz
