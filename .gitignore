# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Datos pesados — referencia, no versionar
sprints/*/objetivo_2_entrenamiento/logs/*.pt
sprints/*/objetivo_2_entrenamiento/logs/*.pth
sprints/*/objetivo_2_entrenamiento/logs/*.h5
sprints/*/objetivo_2_entrenamiento/logs/checkpoints/

# Pero SÍ versionar curvas y métricas de texto
!sprints/*/objetivo_2_entrenamiento/logs/*.csv
!sprints/*/objetivo_2_entrenamiento/logs/*.log
!sprints/*/objetivo_2_entrenamiento/logs/*.json

# Salidas SLURM en logs/ del repo (raw .out/.err pueden ser pesados).
# Copiar a sprints/<sprint>/<objetivo>/logs/ solo lo que valga versionar.
logs/*
!logs/.gitkeep

# Excepción — logs SLURM del experimento completo DSMIL (Objetivo 3,
# Sprint B4, job 4137). Son la única traza post-mortem porque sacct
# está deshabilitado (CLAUDE.md workaround C).
!logs/eg_dsmil_full_4137.out
!logs/eg_dsmil_full_4137.err

# Resultados de entrenamiento (containment: viven bajo results/), pero los
# artefactos pesados NO se versionan. Sí se versiona texto/métricas.
results/**/*.pt
results/**/*.pth
results/**/*.h5
results/**/*.pkl
results/**/checkpoints/
results/**/events.out.tfevents.*
!results/.gitkeep

# Pero SÍ versionar los *_results.pkl (predicciones por slide, pocos KB —
# verdad de referencia que citan los resultados.md de cada sprint).
!results/**/*_results.pkl

# PDFs transitorios del deck de presentación de cada sprint.
# Son referencia visual local (paleta/branding) para diseñar assets, no
# fuente de verdad — el contenido vive en sprints/<sprint>/<obj>/figuras/
# y en `presentacion_contenido_completo.md`. Si en algún sprint se quiere
# un snapshot histórico, commit explícito con `git add -f`.
sprints/**/CLAM_Sprint_*.pdf

# Decks .pptx de cada sprint: derivados locales (branding OnlyOffice), NO fuente
# de verdad. La fuente vive en el generate_*_deck.py + convenciones_deck_*.md + el
# guion. Precedente: 0 pptx trackeados en el repo. Snapshot histórico → `git add -f`.
sprints/**/*.pptx

# Slides locales que Ernesto sube para que Claude las revise/actualice (PDFs,
# pptx, etc.). Carpeta de trabajo local — NO versionar. El contenido de verdad
# vive en sprints/<sprint>/<obj>/ (figuras, guion_montaje, presentacion_*.md).
papers/presentations/

# OBJ-A interpretabilidad MAMMOTH: parches y heatmaps INDIVIDUALES (1000+ PNGs
# full-res, ~1.6GB). Son REGENERABLES con scripts/mammoth_interpretability.py
# desde el checkpoint → se tratan como job output (no van a git). SÍ se versionan
# los entregables-resumen citables (montages, contact sheets, cross_slide, subset,
# expert_usage.csv, meta.json, resultados.md) que quedan fuera de esta regla.
sprints/**/interpretabilidad/*/heatmaps/
sprints/**/interpretabilidad/*/topk_patches/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Claude Code local state
.claude/projects/
.claude/todos/
.claude/cache/
# settings.json acumula permisos pre-aprobados durante el uso (allow-list de
# comandos one-shot, paths absolutos a $HOME/$TMP, etc.). Es local de cada
# usuario/máquina, no config del proyecto — cada sesión nueva reconstruye su
# allow-list naturalmente. Si en el futuro hace falta un baseline compartido,
# crear .claude/settings.json.example curado a mano.
.claude/settings.json

# Secretos
*.env
.env.local
conf.env

# Snapshot pesado del trabajo heredado de Eduardo (mammoth). El código
# irremplazable vive extraído en key_sources/ (committeado); el tarball es
# backup local de 23 MB (incluye assets/PDFs de MAMMOTH), no va a git.
sprints/B4_sprint4/objetivo_6_mammoth/eduardo_snapshot/*.tar.gz
.handoffs/
